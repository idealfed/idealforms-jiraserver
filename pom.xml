<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.idealfed.poc</groupId>
    <artifactId>idealforms</artifactId>
    <version>11.0.1-UNLd</version>
    <organization>
        <name>Ideal Federal LLC</name>
        <url>http://www.idealfed.com</url>
    </organization>
    <name>Ideal Forms for Jira</name>
    <description>This is the Ideal Forms plugin for Atlassian JIRA.</description>
    <packaging>atlassian-plugin</packaging>
    <dependencies>

        <dependency>
            <groupId>com.atlassian.upm</groupId>
            <artifactId>licensing-api</artifactId>
            <!-- VERIFY: confirm current version against the Jira 11.3.8 installed-libs list -->
            <version>3.0.1</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.atlassian.upm</groupId>
            <artifactId>upm-api</artifactId>
            <!-- VERIFY: confirm current version against the Jira 11.3.8 installed-libs list -->
            <version>3.0.1</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>com.atlassian.jira</groupId>
            <artifactId>jira-api</artifactId>
            <version>${jira.version}</version>
            <scope>provided</scope>
        </dependency>
        <!-- Add dependency on jira-core if you want access to JIRA implementation classes as well as the sanctioned API. -->
        <!-- This is not normally recommended, but may be required eg when migrating a plugin originally developed against JIRA 4.x -->
        <!--
        <dependency>
            <groupId>com.atlassian.jira</groupId>
            <artifactId>jira-core</artifactId>
            <version>${jira.version}</version>
            <scope>provided</scope>
        </dependency>
        -->

        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>4.13.2</version>
            <scope>test</scope>
        </dependency>
        <!-- WIRED TEST RUNNER DEPENDENCIES -->
        <dependency>
            <groupId>com.atlassian.plugins</groupId>
            <artifactId>atlassian-plugins-osgi-testrunner</artifactId>
            <version>${plugin.testrunner.version}</version>
            <scope>test</scope>
        </dependency>

        <!--
            REMOVED: javax.ws.rs:jsr311-api (JAX-RS 1.1, obsolete).
            Jira 11 runs on Jakarta EE 10 / Spring 6. If this plugin actually
            declares JAX-RS @Path resources, replace with:

            <dependency>
                <groupId>jakarta.ws.rs</groupId>
                <artifactId>jakarta.ws.rs-api</artifactId>
                <version>3.1.0</version>
                <scope>provided</scope>
            </dependency>

            If no REST resources are defined in this plugin, this dependency
            can simply be dropped.
        -->

        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>2.11.0</version>
        </dependency>
        <!-- Uncomment to use TestKit in your project. Details at https://bitbucket.org/atlassian/jira-testkit -->
        <!-- You can read more about TestKit at https://developer.atlassian.com/display/JIRADEV/Plugin+Tutorial+-+Smarter+integration+testing+with+TestKit -->
        <!--
		<dependency>
			<groupId>com.atlassian.jira.tests</groupId>
			<artifactId>jira-testkit-client</artifactId>
			<version>${testkit.version}</version>
			<scope>test</scope>
		</dependency>
		-->

        <!--
            REPLACED: javax.servlet:servlet-api:2.3.
            Jira 11 bundles Tomcat 10.1, which moved to the jakarta.servlet
            namespace. VERIFY exact jakarta.servlet-api version against what
            Jira 11.3.8 bundles (Jakarta Servlet 6.0/6.1).
        -->
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <version>6.1.0</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>com.atlassian.templaterenderer</groupId>
            <artifactId>atlassian-template-renderer-api</artifactId>
            <version>7.1.2</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.atlassian.activeobjects</groupId>
            <artifactId>activeobjects-plugin</artifactId>
            <version>${ao.version}</version>
            <scope>provided</scope>
        </dependency>

        <!--
            REMOVED: com.google.collections:google-collections:1.0.
            This is the pre-Guava library; everything in it was folded into
            Guava years ago (guava, below, is the only collections dep needed).
        -->

        <dependency>
            <groupId>com.atlassian.sal</groupId>
            <artifactId>sal-api</artifactId>
            <!-- VERIFY: confirm current version against the Jira 11.3.8 installed-libs list -->
            <version>6.0.1</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.google.guava</groupId>
            <artifactId>guava</artifactId>
            <!--
                VERIFY: match this to whatever Guava version Jira 11.3.8 ships
                with (check Administration > Installed Libraries in a running
                instance). Mismatches here are a common source of
                NoSuchMethodError at OSGi runtime even though the build compiles.
            -->
            <version>33.3.1-jre</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>2.0.16</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <!--
                REPLACED: mockito-all:1.8.5 (unmaintained shaded artifact,
                doesn't work well past Java 11 due to its bundled old Hamcrest
                and no support for newer bytecode). mockito-core is the
                maintained artifact.
            -->
            <version>5.14.2</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>jakarta.inject</groupId>
            <artifactId>jakarta.inject-api</artifactId>
            <!--
                REPLACED: javax.inject:javax.inject:1. Under Jakarta EE 10
                (Jira 11's baseline) this is the jakarta.inject namespace.
            -->
            <version>2.0.1</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.atlassian.plugin</groupId>
            <artifactId>atlassian-spring-scanner-annotation</artifactId>
            <version>${atlassian.spring.scanner.version}</version>
            <scope>provided</scope>
        </dependency>
        <!--
            Required alongside the annotation artifact; confirmed via a
            separate working plugin. Without this, the annotation classes
            compile fine but nothing actually activates the scanner's
            runtime wiring behavior.
        -->
        <dependency>
            <groupId>com.atlassian.plugin</groupId>
            <artifactId>atlassian-spring-scanner-runtime</artifactId>
            <version>${atlassian.spring.scanner.version}</version>
            <scope>runtime</scope>
        </dependency>
        <!--
            Confirmed working pattern from a separate plugin (Favorites):
            ActiveObjects wired via importOsgiService() in a @Configuration
            class, rather than relying on @ComponentImport + the scanner.
        -->
        <dependency>
            <groupId>com.atlassian.plugins</groupId>
            <artifactId>atlassian-plugins-osgi-javaconfig</artifactId>
            <version>0.6.1</version>
        </dependency>
        <dependency>
            <groupId>com.atlassian.plugins.rest</groupId>
            <artifactId>atlassian-rest-common</artifactId>
            <!-- VERIFY: confirm current version against the Jira 11.3.8 installed-libs list -->
            <version>6.1.10</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
            <!--
                REPLACED: spring-context:4.3.9.RELEASE.
                Jira 11 upgraded its internal Spring to the 6.x line (which
                required the Jakarta EE 10 baseline). VERIFY the exact 6.x
                patch version Jira 11.3.8 ships with; mismatch here is a
                frequent cause of ClassNotFoundException/NoSuchMethodError
                at plugin-enable time. Scope changed to provided since the
                platform supplies Spring at runtime.
            -->
            <version>6.1.14</version>
            <scope>provided</scope>
        </dependency>

    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>com.atlassian.maven.plugins</groupId>
                <artifactId>jira-maven-plugin</artifactId>
                <version>${amps.version}</version>
                <extensions>true</extensions>
                <configuration>
                    <compressResources>false</compressResources>
                    <pluginArtifacts>
                        <pluginArtifact>
                            <groupId>com.atlassian.activeobjects</groupId>
                            <artifactId>activeobjects-plugin</artifactId>
                            <version>${ao.version}</version>
                        </pluginArtifact>
                        <pluginArtifact>
                            <groupId>com.atlassian.activeobjects</groupId>
                            <artifactId>activeobjects-jira-spi</artifactId>
                            <version>${ao.version}</version>
                        </pluginArtifact>
                    </pluginArtifacts>
                    <productVersion>${jira.version}</productVersion>
                    <productDataVersion>${jira.version}</productDataVersion>
                    <!-- Uncomment to install TestKit backdoor in JIRA. -->
                    <!--
					<pluginArtifacts>
						<pluginArtifact>
							<groupId>com.atlassian.jira.tests</groupId>
							<artifactId>jira-testkit-plugin</artifactId>
							<version>${testkit.version}</version>
						</pluginArtifact>
					</pluginArtifacts>
  -->

                    <instructions>

                        <Atlassian-Plugin-Key>${atlassian.plugin.key}</Atlassian-Plugin-Key>

                        <Export-Package></Export-Package>

                        <!--
                            VERIFY: com.sun.mail.* packages assume javax.mail.
                            Under Jira 11's Jakarta EE 10 baseline this may be
                            exposed as jakarta.mail.* instead (or not exposed
                            at all if this plugin doesn't actually send mail).
                            Test plugin-enable in a real 11.3.8 instance and
                            watch the logs for unresolved OSGi imports.
                        -->
                        <Import-Package>com.sun.mail.imap;resolution:=optional, com.sun.mail.smtp;resolution:=optional, com.sun.mail.pop3;resolution:=optional,*;version="0";resolution:=optional</Import-Package>

                        <Spring-Context>*</Spring-Context>

                        <!--
                            The bnd version bundled with jira-maven-plugin:8.0.0
                            doesn't correctly recognize Java 21 class files and
                            emits a broken Require-Capability:
                            osgi.ee;filter:="(osgi.ee=UNKNOWN)" instead of the
                            correct JavaSE-21 value. UNKNOWN can never be
                            satisfied by any OSGi framework, so the bundle
                            fails to resolve at install regardless of the
                            actual JDK Jira is running.
                            -noee did NOT suppress this in practice (confirmed
                            by inspecting the built manifest); this bnd
                            version's broken EE detection apparently isn't
                            gated by that flag. -removeheaders instead strips
                            the header directly from the final generated
                            manifest as a post-processing step, regardless of
                            why bnd added it, so it doesn't depend on
                            intercepting whatever internal path produced the
                            bad value.
                        -->
                        <_removeheaders>Require-Capability</_removeheaders>

                    </instructions>

                </configuration>
            </plugin>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
                <!--
                    Pinned explicitly: 3.12.0 and later (through at least 3.27.3,
                    per widely-reported upstream issues) have a bug in incremental
                    compilation that throws "Cannot load from object array because
                    this.hashes is null". 3.11.0 predates that bug and still
                    supports <release>.
                -->
                <version>3.11.0</version>
                <configuration>
                    <release>21</release>
                </configuration>
            </plugin>
            <plugin>
                <!--
                    Required now that atlassian-plugin.xml can no longer use
                    <component-import> (AMPS blocks it outright when
                    Atlassian-Plugin-Key is set). This is what actually scans
                    for @Component/@ComponentImport annotations at build time
                    and generates the Spring wiring — the annotation
                    dependency alone does nothing without this.
                -->
                <groupId>com.atlassian.plugin</groupId>
                <artifactId>atlassian-spring-scanner-maven-plugin</artifactId>
                <version>2.2.1</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>atlassian-spring-scanner</goal>
                        </goals>
                        <phase>process-classes</phase>
                    </execution>
                </executions>
                <configuration>
                    <verbose>false</verbose>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.owasp</groupId>
                <artifactId>dependency-check-maven</artifactId>
                <version>10.0.4</version>
                <configuration>
                    <skipProvidedScope>true</skipProvidedScope>
                    <suppressionFiles>
                        <suppressionFile>https://dcapt-downloads.s3.amazonaws.com/atlassian-security-scanner-dc-apps-suppressions.xml</suppressionFile>
                    </suppressionFiles>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
    <properties>
        <!--
            VERIFY: confirm this against active-objects actually bundled
            with Jira 11.3.8 (a Jira 10.3.9 instance was observed running
            active-objects 6.1.2 — a 1.2.1 -> 6.x jump is expected, but
            confirm the exact version for 11.3.8 specifically).
        -->
        <ao.version>6.1.2</ao.version>
        <jira.version>11.3.8</jira.version>
        <!--
            Confirmed to exist as com.atlassian.maven.plugins:jira-maven-plugin:8.0.0
            in the Atlassian Maven repo. Newer releases exist (check
            https://mvnrepository.com/artifact/com.atlassian.maven.plugins/jira-maven-plugin
            or browse packages.atlassian.com) — skip any version with an
            odd suffix like "-dbdelay", those look like internal/experimental
            builds rather than public releases. Bump once you've confirmed
            a newer plain release number resolves for Jira 11.x.
        -->
        <amps.version>8.0.0</amps.version>
        <plugin.testrunner.version>2.0.5</plugin.testrunner.version>
        <!--
            Bumped from 2.2.1: that version's bundled bytecode scanner
            (Javassist 3.16/3.19-GA, ~2012-2014) can't parse Java 21 class
            files, which is why the build log showed "Processed 0 annotated
            classes" no matter what annotations were added. 6.0.2 is the
            version aligned with Platform 7 / Spring 6 (confirmed via a
            separate working Confluence 10 plugin).
        -->
        <atlassian.spring.scanner.version>6.0.2</atlassian.spring.scanner.version>
        <!-- TestKit version — only relevant if you uncomment the TestKit dependency above -->
        <testkit.version>8.31.0</testkit.version>
    </properties>
</project>
